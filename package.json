{
    "name": "@abrahamsaanchez/eslint-config",
    "type": "module",
    "version": "2.1.0",
    "description": "Abraham's ESLint config",
    "author": "Abraham Sánchez <abrahamsaanchez@gmail.com> (https://github.com/abrahamsaanchez/)",
    "license": "MIT",
    "homepage": "https://github.com/abrahamsaanchez/eslint-config",
    "keywords": [
        "eslint-config"
    ],
    "exports": {
        ".": "./dist/index.mjs",
        "./package.json": "./package.json"
    },
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsdown --clean && pnpm run build:types",
        "build:types": "tsc -p tsconfig.build.json",
        "commit": "git-cz",
        "commit:amend": "git add . && git commit --amend --no-edit",
        "dev": "tsdown src/index.ts --format esm,cjs --watch & eslint-config-inspector",
        "lint": "pnpm run typecheck && pnpm run stub && eslint .",
        "lint:fix": "pnpm run stub && eslint --fix .",
        "prepare": "simple-git-hooks",
        "release": "bumpp --commit \"chore: Release v%s.\" && pnpm publish",
        "stub": "tsdown",
        "typecheck": "tsc --noEmit"
    },
    "config": {
        "commitizen": {
            "path": "@commitlint/cz-commitlint"
        }
    },
    "dependencies": {
        "@angular-eslint/template-parser": "21.3.1",
        "@antfu/eslint-config": "8.2.0",
        "@antfu/eslint-define-config": "1.23.0-2",
        "@eslint/markdown": "8.0.1",
        "@typescript-eslint/eslint-plugin": "8.58.2",
        "@typescript-eslint/parser": "8.58.2",
        "eslint-config-flat-gitignore": "2.3.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-import-resolver-typescript": "4.4.4",
        "eslint-plugin-antfu": "3.2.2",
        "eslint-plugin-eslint-comments": "3.2.0",
        "eslint-plugin-import-x": "4.16.2",
        "eslint-plugin-jest": "29.15.2",
        "eslint-plugin-jsdoc": "62.9.0",
        "eslint-plugin-jsonc": "3.1.2",
        "eslint-plugin-n": "17.24.0",
        "eslint-plugin-no-only-tests": "3.3.0",
        "eslint-plugin-perfectionist": "5.8.0",
        "eslint-plugin-prettier": "5.5.5",
        "eslint-plugin-tailwindcss": "3.18.3",
        "eslint-plugin-unicorn": "64.0.0",
        "eslint-plugin-unused-imports": "4.4.1",
        "eslint-plugin-yml": "3.3.1",
        "globals": "17.5.0",
        "jsonc-eslint-parser": "3.1.0",
        "local-pkg": "1.1.2",
        "yaml-eslint-parser": "2.0.0"
    },
    "devDependencies": {
        "@commitlint/cli": "20.5.0",
        "@commitlint/cz-commitlint": "20.5.1",
        "@eslint/config-inspector": "1.5.0",
        "@types/eslint-plugin-tailwindcss": "3.17.0",
        "@types/jest": "30.0.0",
        "@types/node": "25.6.0",
        "bumpp": "11.0.1",
        "eslint": "10.2.0",
        "jest": "30.3.0",
        "simple-git-hooks": "2.13.1",
        "tsdown": "0.21.8",
        "typescript": "6.0.2"
    },
    "simple-git-hooks": {
        "commit-msg": "pnpm commitlint --edit ${1}",
        "pre-commit": "pnpm typecheck && pnpm lint:fix"
    }
}
