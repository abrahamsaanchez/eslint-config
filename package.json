{
    "name": "@abrahamsaanchez/eslint-config",
    "type": "module",
    "version": "2.0.6",
    "description": "Abraham's ESLint config",
    "author": "Abraham Sánchez <abrahamsaanchez@gmail.com> (https://github.com/abrahamsaanchez/)",
    "license": "MIT",
    "homepage": "https://github.com/abrahamsaanchez/eslint-config",
    "keywords": [
        "eslint-config"
    ],
    "exports": {
        ".": "./dist/index.mjs",
        "./package.json": "./package.json"
    },
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsdown src/index.ts --format esm,cjs --clean --dts",
        "commit": "git-cz",
        "commit:amend": "git add . && git commit --amend --no-edit",
        "dev": "tsdown src/index.ts --format esm,cjs --watch & eslint-flat-config-viewer",
        "lint": "pnpm run typecheck && pnpm run stub && eslint .",
        "lint:fix": "pnpm run stub && eslint --fix .",
        "prepack": "nr build",
        "prepare": "simple-git-hooks",
        "release": "bumpp --commit \"chore: Release v%s.\" && pnpm publish",
        "stub": "tsdown src/index.ts --format esm",
        "typecheck": "tsc --noEmit"
    },
    "config": {
        "commitizen": {
            "path": "@commitlint/cz-commitlint"
        }
    },
    "dependencies": {
        "@angular-eslint/template-parser": "21.1.0",
        "@antfu/eslint-define-config": "1.23.0-2",
        "@stylistic/eslint-plugin": "5.6.1",
        "@typescript-eslint/eslint-plugin": "8.50.0",
        "@typescript-eslint/parser": "8.50.0",
        "eslint-config-flat-gitignore": "2.1.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-import-resolver-typescript": "4.4.4",
        "eslint-plugin-antfu": "3.1.1",
        "eslint-plugin-eslint-comments": "3.2.0",
        "eslint-plugin-import-x": "4.16.1",
        "eslint-plugin-jest": "29.9.0",
        "eslint-plugin-jsdoc": "61.5.0",
        "eslint-plugin-jsonc": "2.21.0",
        "eslint-plugin-markdown": "5.1.0",
        "eslint-plugin-n": "17.23.1",
        "eslint-plugin-no-only-tests": "3.3.0",
        "eslint-plugin-perfectionist": "5.0.0",
        "eslint-plugin-prettier": "5.5.4",
        "eslint-plugin-tailwindcss": "3.18.2",
        "eslint-plugin-unicorn": "62.0.0",
        "eslint-plugin-unused-imports": "4.3.0",
        "eslint-plugin-yml": "1.19.1",
        "globals": "16.5.0",
        "jsonc-eslint-parser": "2.4.2",
        "local-pkg": "1.1.2",
        "yaml-eslint-parser": "1.3.2"
    },
    "devDependencies": {
        "@antfu/eslint-config": "6.7.3",
        "@antfu/ni": "28.0.0",
        "@commitlint/cli": "20.2.0",
        "@commitlint/cz-commitlint": "20.2.0",
        "@stylistic/eslint-plugin-migrate": "4.4.1",
        "@types/eslint": "9.6.1",
        "@types/fs-extra": "11.0.4",
        "@types/jest": "30.0.0",
        "@types/node": "25.0.3",
        "bumpp": "10.3.2",
        "eslint": "9.39.2",
        "eslint-flat-config-viewer": "0.1.20",
        "esno": "4.8.0",
        "fast-glob": "3.3.3",
        "fs-extra": "11.3.3",
        "jest": "30.2.0",
        "rimraf": "6.1.2",
        "simple-git-hooks": "2.13.1",
        "sucrase": "3.35.1",
        "tsdown": "^0.18.2",
        "typescript": "5.9.3",
        "unbuild": "3.6.1"
    },
    "peerDependencies": {
        "eslint": ">=9.10.0"
    },
    "simple-git-hooks": {
        "commit-msg": "pnpm commitlint --edit ${1}",
        "pre-commit": "pnpm typecheck && pnpm lint:fix"
    }
}
